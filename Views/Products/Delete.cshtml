@model StoreWave.DTOs.ProductDto

@{
    ViewData["Title"] = "Delete Product";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border-0">
                <div class="card-header py-3" style="background: rgba(244, 63, 94, 0.15) !important; border-bottom: 1px solid rgba(244, 63, 94, 0.3) !important;">
                    <h4 class="card-title fw-bold mb-0" style="color: var(--danger);">
                        <i class="bi bi-exclamation-triangle me-2"></i>Delete Product
                    </h4>
                </div>
                <div class="card-body p-4 text-center">
                    <i class="bi bi-exclamation-triangle display-1 mb-3" style="color: var(--danger);"></i>
                    <h5 class="mb-3">Are you sure you want to delete this?</h5>
                    <p class="text-muted mb-4">
                        You are about to delete <strong>@Model.Name</strong>. This action cannot be undone.
                    </p>

                    <div class="card border-0 p-3 mb-4 text-start" style="background: rgba(99, 102, 241, 0.06) !important;">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">Price</dt>
                            <dd class="col-sm-8" style="color: var(--primary-light);">$@Model.Price</dd>
                            <dt class="col-sm-4">Category</dt>
                            <dd class="col-sm-8">@Model.CategoryName</dd>
                        </dl>
                    </div>
                    
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1 rounded-pill">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger flex-grow-1 rounded-pill">
                                <i class="bi bi-trash me-1"></i>Delete Permanently
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
