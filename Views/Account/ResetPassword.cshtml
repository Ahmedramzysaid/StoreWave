@model StoreWave.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Reset Password";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 auth-card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="auth-icon mb-2">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <h2 class="mt-2 fw-bold">Reset Password</h2>
                        <p class="text-muted">Create a strong new password for your account.</p>
                    </div>

                    <form asp-action="ResetPassword" method="post">
                        <input type="hidden" asp-for="Email" />
                        <input type="hidden" asp-for="OTP" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="NewPassword" class="form-control" placeholder="New password" autocomplete="new-password" />
                            <label asp-for="NewPassword"><i class="bi bi-lock me-1"></i>New Password</label>
                            <span asp-validation-for="NewPassword" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-4">
                            <input asp-for="ConfirmPassword" class="form-control" placeholder="Confirm password" autocomplete="new-password" />
                            <label asp-for="ConfirmPassword"><i class="bi bi-lock-fill me-1"></i>Confirm Password</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- Password Requirements -->
                        <div class="card border-0 mb-4" style="background: rgba(76, 175, 80, 0.08) !important;">
                            <div class="card-body py-3">
                                <small class="text-muted">
                                    <i class="bi bi-shield-check me-1"></i><strong>Password must:</strong>
                                    <ul class="mb-0 mt-1 ps-3" style="line-height: 1.8;">
                                        <li>Be at least 6 characters long</li>
                                    </ul>
                                </small>
                            </div>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-success btn-lg rounded-pill">
                                <i class="bi bi-check2-all me-1"></i>Reset Password
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="mb-0">
                                <a asp-action="Login" style="color: var(--text-link);">
                                    <i class="bi bi-arrow-left me-1"></i>Back to Login
                                </a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
