@model StoreWave.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">
            <div class="card border-0 auth-card">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <div class="auth-icon mb-2">
                            <i class="bi bi-shield-lock"></i>
                        </div>
                        <h2 class="mt-2 fw-bold">Forgot Password?</h2>
                        <p class="text-muted">No worries! Enter your email and we'll send you a verification code.</p>
                    </div>

                    <form asp-action="ForgotPassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-floating mb-4">
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" autocomplete="email" />
                            <label asp-for="Email"><i class="bi bi-envelope me-1"></i>Email Address</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-warning btn-lg rounded-pill">
                                <i class="bi bi-send me-1"></i>Send OTP Code
                            </button>
                        </div>

                        <div class="text-center">
                            <p class="mb-0">
                                <i class="bi bi-arrow-left me-1"></i>
                                <a asp-action="Login" style="color: var(--text-link);">Back to Login</a>
                            </p>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Info Card -->
            <div class="card border-0 mt-3" style="background: rgba(255, 193, 7, 0.08) !important;">
                <div class="card-body text-center py-3">
                    <small class="text-muted">
                        <i class="bi bi-info-circle me-1"></i>
                        The OTP code will expire in <strong>15 minutes</strong>.
                        Check your spam folder if you don't see the email.
                    </small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
