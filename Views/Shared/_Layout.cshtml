<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - StoreWave</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark border-bottom py-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-bag-check-fill me-2"></i>StoreWave
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i>Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-grid me-1"></i>Shop
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-primary fw-semibold" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-speedometer2 me-1"></i>Admin
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Supplier"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-success fw-semibold" asp-controller="Supplier" asp-action="Index">
                                    <i class="bi bi-shop me-1"></i>Supplier Dashboard
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("WarehouseManager"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-info fw-semibold" asp-controller="Warehouse" asp-action="Index">
                                    <i class="bi bi-building me-1"></i>Warehouse
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Accountant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-semibold" asp-controller="Accountant" asp-action="Index">
                                    <i class="bi bi-graph-up me-1"></i>Financials
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav ms-auto align-items-center">
                        <li class="nav-item me-3">
                            <form class="d-flex" asp-controller="Products" asp-action="Index" method="get">
                                <div class="input-group">
                                    <input class="form-control rounded-start" type="search" name="searchString" placeholder="Search products..." aria-label="Search" style="min-width: 200px;">
                                    <button class="btn btn-outline-primary rounded-end" type="submit" style="border-left: none !important;">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                            </form>
                        </li>
                        <li class="nav-item position-relative me-2">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 fs-5"></i>
                                <span class="position-absolute top-1 start-100 translate-middle badge rounded-pill bg-danger" id="cartBadge">
                                    0
                                </span>
                            </a>
                        </li>
                        <partial name="_LoginPartial" />
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container py-4 mb-5">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <!-- Toast Notification -->
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
      <div id="orderToast" class="toast" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="toast-header bg-success text-white">
          <i class="bi bi-bell-fill me-2"></i>
          <strong class="me-auto">New Order Received!</strong>
          <small>Just now</small>
          <button type="button" class="btn-close btn-close-white" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
        <div class="toast-body">
          Order <strong id="toastOrderNum"></strong> placed for <strong id="toastTotal"></strong>.
        </div>
      </div>
    </div>

    <footer class="footer mt-auto">
        <div class="container text-center">
            <p class="mb-1" style="color: var(--text-secondary);">
                <i class="bi bi-bag-check-fill me-1" style="color: var(--primary-light);"></i>
                &copy; 2026 - <strong>StoreWave</strong>
            </p>
            <small>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" style="color: var(--text-muted);">Privacy</a>
            </small>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
