@model IEnumerable<StoreWave.ViewModels.PaymentMethodStatsViewModel>

@{
    ViewData["Title"] = "Payment Method Statistics";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">
                <i class="bi bi-credit-card me-2"></i>Payment Method Statistics
            </h1>
            <p class="text-muted mb-0">Breakdown of payments by method</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row g-4">
            @{
                var colors = new[] { "bg-primary", "bg-success", "bg-info", "bg-warning", "bg-danger" };
                var index = 0;
                var total = Model.Sum(p => p.TotalAmount);
            }
            @foreach (var payment in Model)
            {
                var percentage = total > 0 ? (int)((payment.TotalAmount / total) * 100) : 0;
                <div class="col-md-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h5 class="fw-bold mb-1">@payment.PaymentMethod</h5>
                                    <span class="badge @colors[index % colors.Length] bg-opacity-25 text-dark">@percentage% of total</span>
                                </div>
                                <div class="text-end">
                                    <h4 class="text-success mb-0">$@payment.TotalAmount.ToString("N2")</h4>
                                    <small class="text-muted">@payment.OrderCount orders</small>
                                </div>
                            </div>
                            <div class="progress" style="height: 10px;">
                                <div class="progress-bar @colors[index % colors.Length]" role="progressbar" 
                                     style="width: @percentage%;" 
                                     aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                index++;
            }
        </div>

        <!-- Summary Table -->
        <div class="card border-0 shadow-sm mt-4">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2"></i>Detailed Breakdown</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Payment Method</th>
                            <th>Order Count</th>
                            <th>Total Amount</th>
                            <th>Average Order</th>
                            <th>Share</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var payment in Model)
                        {
                            var percentage = total > 0 ? ((payment.TotalAmount / total) * 100) : 0;
                            <tr>
                                <td class="fw-medium">@payment.PaymentMethod</td>
                                <td>@payment.OrderCount</td>
                                <td class="text-success fw-bold">$@payment.TotalAmount.ToString("N2")</td>
                                <td>$@(payment.OrderCount > 0 ? (payment.TotalAmount / payment.OrderCount).ToString("N2") : "0.00")</td>
                                <td>@percentage.ToString("N1")%</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr class="fw-bold">
                            <td>Total</td>
                            <td>@Model.Sum(p => p.OrderCount)</td>
                            <td class="text-success">$@total.ToString("N2")</td>
                            <td>-</td>
                            <td>100%</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-credit-card-2-front display-1 text-muted"></i>
                <h4 class="mt-3">No Payment Data</h4>
                <p class="text-muted">No orders have been placed yet.</p>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
