@model IEnumerable<StoreWave.ViewModels.MonthlyRevenueViewModel>

@{
    ViewData["Title"] = "Monthly Revenue";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">
                <i class="bi bi-graph-up me-2"></i>Monthly Revenue
            </h1>
            <p class="text-muted mb-0">Revenue breakdown by month (last 12 months)</p>
        </div>
    </div>

    @if (Model.Any())
    {
        <!-- Summary -->
        <div class="row g-4 mb-4">
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-success text-white">
                    <div class="card-body text-center">
                        <h2 class="mb-0">$@Model.Sum(m => m.Revenue).ToString("N2")</h2>
                        <p class="mb-0 opacity-75">Total Revenue (12 months)</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-primary text-white">
                    <div class="card-body text-center">
                        <h2 class="mb-0">@Model.Sum(m => m.OrderCount)</h2>
                        <p class="mb-0 opacity-75">Total Orders</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card border-0 shadow-sm bg-info text-white">
                    <div class="card-body text-center">
                        <h2 class="mb-0">$@(Model.Any() ? (Model.Sum(m => m.Revenue) / Model.Count()).ToString("N2") : "0.00")</h2>
                        <p class="mb-0 opacity-75">Avg Monthly Revenue</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Monthly Breakdown -->
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h5 class="mb-0 fw-bold"><i class="bi bi-calendar3 me-2"></i>Monthly Breakdown</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Month</th>
                            <th>Orders</th>
                            <th>Revenue</th>
                            <th>Avg Order Value</th>
                            <th>Progress</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var maxRevenue = Model.Max(m => m.Revenue);
                        }
                        @foreach (var month in Model)
                        {
                            var percentage = maxRevenue > 0 ? (int)((month.Revenue / maxRevenue) * 100) : 0;
                            <tr>
                                <td class="fw-medium">@month.MonthName</td>
                                <td>@month.OrderCount</td>
                                <td class="text-success fw-bold">$@month.Revenue.ToString("N2")</td>
                                <td>$@(month.OrderCount > 0 ? (month.Revenue / month.OrderCount).ToString("N2") : "0.00")</td>
                                <td style="min-width: 200px;">
                                    <div class="progress" style="height: 20px;">
                                        <div class="progress-bar bg-success" role="progressbar" 
                                             style="width: @percentage%;" 
                                             aria-valuenow="@percentage" aria-valuemin="0" aria-valuemax="100">
                                            @percentage%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-graph-up display-1 text-muted"></i>
                <h4 class="mt-3">No Revenue Data</h4>
                <p class="text-muted">No orders have been placed yet.</p>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
