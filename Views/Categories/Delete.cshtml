@model StoreWave.DTOs.CategoryDto

@{
    ViewData["Title"] = "Delete Category";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0">
                <div class="card-header py-3" style="background: rgba(244, 63, 94, 0.15) !important; border-bottom: 1px solid rgba(244, 63, 94, 0.3) !important;">
                    <h4 class="card-title fw-bold mb-0" style="color: var(--danger);">
                        <i class="bi bi-exclamation-triangle me-2"></i>Delete Category
                    </h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-exclamation-circle me-2"></i>
                        Are you sure you want to delete this category? This action cannot be undone.
                    </div>
                    
                    <div class="card border-0 p-3 mb-4" style="background: rgba(99, 102, 241, 0.06) !important;">
                        <h5 class="fw-bold">@Model.Name</h5>
                        <p class="text-muted mb-2">@(Model.Description ?? "No description")</p>
                        <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                            @(Model.IsActive ? "Active" : "Inactive")
                        </span>
                        <span class="badge bg-primary ms-1">@Model.ProductCount products</span>
                    </div>
                    
                    @if (Model.ProductCount > 0)
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-x-circle me-2"></i>
                            <strong>Warning:</strong> This category has @Model.ProductCount associated products. 
                            You cannot delete it until all products are removed or reassigned.
                        </div>
                    }
                    
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary flex-grow-1 rounded-pill">
                                <i class="bi bi-arrow-left me-2"></i>Cancel
                            </a>
                            <button type="submit" class="btn btn-danger flex-grow-1 rounded-pill" @(Model.ProductCount > 0 ? "disabled" : "")>
                                <i class="bi bi-trash me-2"></i>Delete Category
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
