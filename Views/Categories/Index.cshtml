@model IEnumerable<StoreWave.DTOs.CategoryDto>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="py-4">
    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center mb-4 gap-2">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-tags me-2" style="color: var(--primary-light);"></i>
            <span class="gradient-text">Manage Categories</span>
        </h2>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-primary rounded-pill px-3">
                <i class="bi bi-plus-circle me-2"></i>Add Category
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-arrow-left me-2"></i>Dashboard
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0">
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-tags display-4" style="color: var(--text-muted);"></i>
                    <p class="mt-2 text-muted">No categories found.</p>
                    <a asp-action="Create" class="btn btn-primary rounded-pill">Create First Category</a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Products</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var category in Model)
                            {
                                <tr>
                                    <td class="align-middle fw-semibold">@category.Name</td>
                                    <td class="align-middle text-muted">
                                        @(string.IsNullOrEmpty(category.Description) ? "No description" : (category.Description.Length > 50 ? category.Description.Substring(0, 50) + "..." : category.Description))
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-primary">@category.ProductCount products</span>
                                    </td>
                                    <td class="align-middle">
                                        @if (category.IsActive)
                                        {
                                            <span class="badge bg-success">Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactive</span>
                                        }
                                    </td>
                                    <td class="align-middle text-end">
                                        <a asp-action="Details" asp-route-id="@category.Id" class="btn btn-sm btn-outline-info rounded-pill">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@category.Id" class="btn btn-sm btn-outline-danger rounded-pill">
                                            <i class="bi bi-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
