@model StoreWave.DTOs.CategoryDto

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h4 class="card-title fw-bold mb-0"><i class="bi bi-tag me-2"></i>@Model.Name</h4>
                    <span class="badge @(Model.IsActive ? "bg-success" : "bg-secondary")">
                        @(Model.IsActive ? "Active" : "Inactive")
                    </span>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <div class="text-center mb-4">
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 200px;">
                        </div>
                    }
                    
                    <div class="mb-3">
                        <h6 class="text-muted">Description</h6>
                        <p>@(Model.Description ?? "No description available")</p>
                    </div>
                    
                    <div class="mb-4">
                        <h6 class="text-muted">Statistics</h6>
                        <span class="badge bg-primary fs-6">@Model.ProductCount products</span>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-pencil me-2"></i>Edit
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i>
                        </a>
                        <a asp-action="Index" class="btn btn-outline-secondary">Back</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
