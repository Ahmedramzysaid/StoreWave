@model StoreWave.DTOs.OrderDto

@using StoreWave.Models.Entities

@{
    ViewData["Title"] = "Order Details";
    var currentUserId = (int)ViewBag.CurrentUserId;
    var chatMessages = (List<ChatMessage>)ViewBag.ChatMessages;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold mb-0">
            <i class="bi bi-receipt me-2"></i>Order @Model.OrderNumber
        </h2>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Back to Orders
        </a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Order Items -->
            <div class="card border-0 mb-4">
                <div class="card-header py-3">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-bag me-2"></i>Items
                    </h5>
                </div>
                <div class="card-body p-0">
                    <table class="table mb-0">
                        <tbody>
                            @foreach (var item in Model.OrderItems)
                            {
                                <tr>
                                    <td class="p-3">
                                        <div class="d-flex align-items-center">
                                            <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "https://placehold.co/100x100?text=Product" : item.ProductImageUrl)"
                                                 class="rounded me-3 border" style="width: 60px; height: 60px; object-fit: cover;">
                                            <div>
                                                <h6 class="mb-0">@item.ProductName</h6>
                                                <small class="text-muted">Qty: @item.Quantity</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="p-3 text-end">
                                        <div>$@item.TotalPrice</div>
                                        <small class="text-muted">$@item.UnitPrice each</small>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Order Summary -->
            <div class="card border-0 mb-4">
                <div class="card-header py-3">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-clipboard-data me-2"></i>Order Summary
                    </h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Date</span>
                        <span>@Model.OrderDate.ToString("g")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Status</span>
                        <span class="badge @(Model.Status.ToString() == "Delivered" ? "bg-success" :
                                              Model.Status.ToString() == "Cancelled" ? "bg-danger" :
                                              Model.Status.ToString() == "Pending" ? "bg-warning" : "bg-info")">
                            @Model.Status
                        </span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Payment</span>
                        <span>@Model.PaymentMethod</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Subtotal</span>
                        <span>$@Model.SubTotal</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Shipping</span>
                        <span>$@Model.ShippingCost</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-5 text-success">$@Model.TotalAmount</span>
                    </div>
                </div>
            </div>

            <!-- Shipping Address -->
            <div class="card border-0">
                <div class="card-header py-3">
                    <h5 class="card-title fw-bold mb-0">
                        <i class="bi bi-geo-alt me-2"></i>Shipping Address
                    </h5>
                </div>
                <div class="card-body">
                    <address class="mb-0">
                        <strong>@Model.CustomerName</strong><br>
                        @Model.ShippingAddress<br>
                        @Model.ShippingCity, @Model.ShippingCountry @Model.ShippingPostalCode
                    </address>
                </div>
            </div>
        </div>

        <!-- Live Chat Section -->
        <div class="col-12">
            <div class="card border-0" id="chatSection">
                <div class="card-header py-3 d-flex justify-content-between align-items-center"
                     style="background: linear-gradient(135deg, rgba(99,102,241,0.12), rgba(139,92,246,0.08)) !important; cursor: pointer;"
                     id="chatToggle">
                    <h5 class="fw-bold mb-0">
                        <i class="bi bi-chat-dots me-2" style="color: var(--primary-light);"></i>Chat with Support
                    </h5>
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-success" id="chatStatus" style="display:none;">
                            <i class="bi bi-circle-fill me-1" style="font-size: 0.5rem;"></i>Connected
                        </span>
                        <i class="bi bi-chevron-down" id="chatChevron" style="transition: transform 0.3s;"></i>
                    </div>
                </div>
                <div id="chatBody" style="display: block;">
                    <div class="card-body p-0">
                        <!-- Messages Area -->
                        <div id="chatMessages" style="height: 350px; overflow-y: auto; padding: 1.2rem;">
                            @if (!chatMessages.Any())
                            {
                                <div class="text-center text-muted py-5" id="emptyChat">
                                    <i class="bi bi-chat-square-text display-4"></i>
                                    <p class="mt-2 mb-0">No messages yet. Start a conversation with support!</p>
                                </div>
                            }
                            else
                            {
                                <div id="emptyChat" style="display:none;"></div>
                                @foreach (var msg in chatMessages)
                                {
                                    var isMine = msg.SenderId == currentUserId;
                                    <div class="chat-bubble @(isMine ? "sent" : "received")">
                                        @if (!isMine)
                                        {
                                            <div class="chat-sender">🛡️ @msg.Sender.FullName (Support)</div>
                                        }
                                        <div>@msg.Message</div>
                                        <div class="chat-meta">
                                            @msg.SentAt.ToString("MMM dd, hh:mm tt")
                                            @if (msg.IsRead)
                                            {
                                                <i class="bi bi-check2-all ms-1" style="color: #38bdf8;"></i>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>

                        <!-- Input Area -->
                        <div style="border-top: 1px solid var(--border-color); padding: 1rem 1.2rem;">
                            <div class="input-group">
                                <input type="text" id="chatInput" class="form-control"
                                       placeholder="Type your message..." autocomplete="off"
                                       style="border-radius: 25px 0 0 25px; padding: 0.6rem 1.2rem;" />
                                <button id="chatSendBtn" class="btn btn-primary"
                                        style="border-radius: 0 25px 25px 0; padding: 0.6rem 1.5rem;">
                                    <i class="bi bi-send"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .chat-bubble {
        max-width: 75%;
        padding: 0.6rem 1rem;
        border-radius: 16px;
        margin-bottom: 0.8rem;
        position: relative;
        word-wrap: break-word;
        animation: fadeInUp 0.3s ease;
    }

    @@keyframes fadeInUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .chat-bubble.sent {
        background: var(--gradient-primary);
        color: #fff;
        margin-left: auto;
        border-bottom-right-radius: 4px;
    }

    .chat-bubble.received {
        background: rgba(99, 102, 241, 0.1);
        color: var(--text-primary);
        margin-right: auto;
        border-bottom-left-radius: 4px;
    }

    .chat-bubble .chat-meta {
        font-size: 0.7rem;
        opacity: 0.7;
        margin-top: 0.3rem;
    }

    .chat-bubble .chat-sender {
        font-size: 0.75rem;
        font-weight: 600;
        margin-bottom: 0.2rem;
    }

    .chat-bubble.received .chat-sender {
        color: var(--primary-light);
    }

    #chatMessages::-webkit-scrollbar { width: 4px; }
    #chatMessages::-webkit-scrollbar-thumb { background: rgba(99,102,241,0.3); border-radius: 4px; }

    .typing-indicator {
        display: none;
        padding: 0.5rem 1rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        font-style: italic;
    }
</style>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>
    <script>
        (function () {
            const orderId = @Model.Id;
            const currentUserId = @currentUserId;
            const chatMessages = document.getElementById('chatMessages');
            const chatInput = document.getElementById('chatInput');
            const chatSendBtn = document.getElementById('chatSendBtn');
            const emptyChat = document.getElementById('emptyChat');
            const chatStatus = document.getElementById('chatStatus');
            const chatToggle = document.getElementById('chatToggle');
            const chatBody = document.getElementById('chatBody');
            const chatChevron = document.getElementById('chatChevron');

            // Scroll to bottom on page load (to show latest messages)
            chatMessages.scrollTop = chatMessages.scrollHeight;

            // Toggle chat body
            chatToggle.addEventListener('click', function () {
                const isVisible = chatBody.style.display !== 'none';
                chatBody.style.display = isVisible ? 'none' : 'block';
                chatChevron.style.transform = isVisible ? 'rotate(-90deg)' : 'rotate(0deg)';
            });

            // SignalR Connection
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/chatHub")
                .withAutomaticReconnect()
                .build();

            connection.start()
                .then(() => {
                    chatStatus.style.display = 'inline-flex';
                    connection.invoke("JoinOrderChat", orderId);
                    connection.invoke("MarkAsRead", orderId);
                })
                .catch(err => console.error('Chat connection failed:', err));

            connection.onreconnected(() => {
                chatStatus.style.display = 'inline-flex';
                connection.invoke("JoinOrderChat", orderId);
            });

            connection.onclose(() => {
                chatStatus.style.display = 'none';
            });

            // Receive messages
            connection.on("ReceiveMessage", function (msg) {
                emptyChat.style.display = 'none';
                appendMessage(msg);
                scrollToBottom();

                // Mark as read if message is from other party
                if (msg.senderId !== currentUserId) {
                    connection.invoke("MarkAsRead", orderId);
                }
            });

            // Send message
            function sendMessage() {
                const text = chatInput.value.trim();
                if (!text) return;

                connection.invoke("SendMessage", orderId, text)
                    .catch(err => console.error('Send failed:', err));

                chatInput.value = '';
                chatInput.focus();
            }

            chatSendBtn.addEventListener('click', sendMessage);
            chatInput.addEventListener('keydown', function (e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    sendMessage();
                }
            });

            // Build message bubble
            function appendMessage(msg) {
                const isMine = msg.senderId === currentUserId;
                const bubble = document.createElement('div');
                bubble.className = `chat-bubble ${isMine ? 'sent' : 'received'}`;

                let senderLabel = '';
                if (!isMine) {
                    const icon = msg.isAdminReply ? '🛡️ ' : '';
                    senderLabel = `<div class="chat-sender">${icon}${msg.senderName}</div>`;
                }

                bubble.innerHTML = `
                    ${senderLabel}
                    <div>${escapeHtml(msg.message)}</div>
                    <div class="chat-meta">${msg.sentAt}</div>
                `;

                chatMessages.appendChild(bubble);
            }

            function scrollToBottom() {
                chatMessages.scrollTop = chatMessages.scrollHeight;
            }

            function escapeHtml(text) {
                const div = document.createElement('div');
                div.textContent = text;
                return div.innerHTML;
            }
        })();
    </script>
}
