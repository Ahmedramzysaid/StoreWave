@model IEnumerable<StoreWave.DTOs.OrderDto>

@{
    ViewData["Title"] = "My Orders";
}

<div class="container py-5">
    <h2 class="fw-bold mb-4">My Orders</h2>

    @if (!Model.Any())
    {
        <div class="alert alert-info border-0 shadow-sm">
            <i class="bi bi-info-circle me-2"></i> You haven't placed any orders yet.
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="border-0 p-3">Order #</th>
                                <th class="border-0 p-3">Date</th>
                                <th class="border-0 p-3">Status</th>
                                <th class="border-0 p-3">Total</th>
                                <th class="border-0 p-3">Items</th>
                                <th class="border-0 p-3 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="p-3">@order.OrderNumber</td>
                                    <td class="p-3">@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                    <td class="p-3">
                                        <span class="badge bg-@(order.Status.ToString() == "Delivered" ? "success" : "primary")">
                                            @order.Status
                                        </span>
                                    </td>
                                    <td class="p-3 fw-bold">$@order.TotalAmount</td>
                                    <td class="p-3">@order.ItemCount</td>
                                    <td class="p-3 text-end">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">View</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>
