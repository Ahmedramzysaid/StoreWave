@model IEnumerable<StoreWave.DTOs.ProductDto>

@{
    ViewData["Title"] = "Inventory Management";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">
                <i class="bi bi-box-seam me-2"></i>Inventory Management
            </h1>
            <p class="text-muted mb-0">Manage stock levels for all products</p>
        </div>
        <a asp-action="LowStock" class="btn btn-warning">
            <i class="bi bi-exclamation-triangle me-1"></i>Low Stock Only
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock Quantity</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model)
                    {
                        <tr class="@(product.StockQuantity == 0 ? "table-danger" : product.StockQuantity <= 10 ? "table-warning" : "")">
                            <td>
                                <div class="d-flex align-items-center">
                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/40x40?text=P" : product.ImageUrl)" 
                                         class="rounded me-2" width="40" height="40" style="object-fit: cover;" />
                                    <span class="fw-medium">@product.Name</span>
                                </div>
                            </td>
                            <td>@product.CategoryName</td>
                            <td>$@product.CurrentPrice.ToString("N2")</td>
                            <td>
                                <span class="badge @(product.StockQuantity == 0 ? "bg-danger" : product.StockQuantity <= 10 ? "bg-warning text-dark" : "bg-success") fs-6">
                                    @product.StockQuantity
                                </span>
                            </td>
                            <td>
                                @if (product.StockQuantity == 0)
                                {
                                    <span class="text-danger fw-bold">
                                        <i class="bi bi-x-circle me-1"></i>Out of Stock
                                    </span>
                                }
                                else if (product.StockQuantity <= 10)
                                {
                                    <span class="text-warning fw-bold">
                                        <i class="bi bi-exclamation-triangle me-1"></i>Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="text-success">
                                        <i class="bi bi-check-circle me-1"></i>In Stock
                                    </span>
                                }
                            </td>
                            <td>
                                <a asp-action="UpdateStock" asp-route-id="@product.Id" class="btn btn-sm btn-primary">
                                    <i class="bi bi-pencil me-1"></i>Update Stock
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
