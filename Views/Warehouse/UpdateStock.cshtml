@model StoreWave.DTOs.ProductDto

@{
    ViewData["Title"] = "Update Stock";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white py-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-box-seam me-2"></i>Update Stock
                    </h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "https://placehold.co/150x150?text=Product" : Model.ImageUrl)" 
                             class="rounded border" style="max-height: 150px;" />
                        <h5 class="mt-3">@Model.Name</h5>
                        <p class="text-muted">@Model.CategoryName</p>
                    </div>

                    <div class="alert @(Model.StockQuantity == 0 ? "alert-danger" : Model.StockQuantity <= 10 ? "alert-warning" : "alert-success") text-center">
                        <strong>Current Stock:</strong> @Model.StockQuantity units
                    </div>

                    <form asp-action="UpdateStock" method="post">
                        <input type="hidden" name="id" value="@Model.Id" />
                        
                        <div class="mb-4">
                            <label class="form-label">New Stock Quantity</label>
                            <input type="number" name="stockQuantity" class="form-control form-control-lg text-center" 
                                   value="@Model.StockQuantity" min="0" step="1" required />
                            <small class="text-muted">Enter the new total stock quantity</small>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-lg me-1"></i>Update Stock
                            </button>
                            <a asp-action="Inventory" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
