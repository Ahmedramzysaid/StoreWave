@model StoreWave.DTOs.OrderDto

@{
    ViewData["Title"] = "Order Confirmed";
}

<div class="py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card border-0 text-center" style="border: 1px solid rgba(16, 185, 129, 0.3) !important;">
                <div class="card-body p-5">
                    <div class="mb-4" style="animation: fadeInUp 0.6s ease-out;">
                        <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-4" 
                             style="width: 100px; height: 100px; background: var(--gradient-success); box-shadow: 0 8px 32px rgba(16, 185, 129, 0.3);">
                            <i class="bi bi-check-lg display-3 text-white"></i>
                        </div>
                        <h2 class="fw-bold">Order Confirmed!</h2>
                        <p class="text-muted lead mb-1">Thank you for your purchase</p>
                    </div>

                    <div class="card border-0 mb-4 text-start" style="background: rgba(99, 102, 241, 0.06) !important;">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-6 mb-3">
                                    <small class="text-muted d-block">Order Number</small>
                                    <strong style="color: var(--primary-light);">@Model.OrderNumber</strong>
                                </div>
                                <div class="col-6 mb-3">
                                    <small class="text-muted d-block">Total</small>
                                    <strong class="gradient-text">$@Model.TotalAmount.ToString("N2")</strong>
                                </div>
                                <div class="col-6 mb-3">
                                    <small class="text-muted d-block">Payment</small>
                                    <strong>@Model.PaymentMethod</strong>
                                </div>
                                <div class="col-6 mb-3">
                                    <small class="text-muted d-block">Date</small>
                                    <strong>@Model.OrderDate.ToString("MMM dd, yyyy")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex flex-wrap gap-2 justify-content-center">
                        <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-primary rounded-pill px-4">
                            <i class="bi bi-receipt me-1"></i>View Order
                        </a>
                        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                            <i class="bi bi-bag me-1"></i>Continue Shopping
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
