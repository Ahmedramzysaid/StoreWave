@model List<StoreWave.Services.Interfaces.OrderChatSummary>

@{
    ViewData["Title"] = "Order Chats";
    var totalUnread = (int)(ViewBag.TotalUnread ?? 0);
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">
                <i class="bi bi-chat-dots me-2" style="color: var(--primary-light);"></i>Order Chats
            </h1>
            <p class="text-muted mb-0">
                Manage customer conversations
                @if (totalUnread > 0)
                {
                    <span class="badge bg-danger ms-2">@totalUnread unread</span>
                }
            </p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left me-1"></i>Dashboard
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="row g-3">
            @foreach (var chat in Model)
            {
                <div class="col-12">
                    <a asp-action="OrderChat" asp-route-id="@chat.OrderId" class="text-decoration-none">
                        <div class="card border-0 @(chat.UnreadCount > 0 ? "" : "")" style="@(chat.UnreadCount > 0 ? "border-left: 3px solid var(--primary) !important;" : "")">
                            <div class="card-body py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center gap-3">
                                        <!-- Avatar -->
                                        @{
                                            var nameParts = (chat.CustomerName ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
                                            var initials = nameParts.Length >= 2
                                                ? $"{nameParts[0][0]}{nameParts[1][0]}"
                                                : nameParts.Length == 1 && nameParts[0].Length >= 2 ? nameParts[0].Substring(0, 2) : "??";
                                        }
                                        <div style="width:48px; height:48px; border-radius:50%; display:flex; align-items:center; justify-content:center;
                                                    background: var(--gradient-primary); color:#fff; font-weight:700; font-size:1rem; flex-shrink:0;">
                                            @initials.ToUpper()
                                        </div>
                                        <div>
                                            <h6 class="mb-0 fw-bold" style="color: var(--text-primary);">
                                                @chat.CustomerName
                                                <small class="fw-normal text-muted ms-2">@chat.OrderNumber</small>
                                            </h6>
                                            <p class="mb-0 text-muted" style="font-size: 0.85rem; max-width: 500px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                                @(chat.LastMessage.Length > 80 ? chat.LastMessage.Substring(0, 80) + "..." : chat.LastMessage)
                                            </p>
                                        </div>
                                    </div>
                                    <div class="text-end d-flex flex-column align-items-end gap-1">
                                        <small class="text-muted">@chat.LastMessageTime.ToString("MMM dd, hh:mm tt")</small>
                                        @if (chat.UnreadCount > 0)
                                        {
                                            <span class="badge bg-primary rounded-pill">@chat.UnreadCount</span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-chat-square-text display-1 text-muted"></i>
            <h4 class="mt-3">No Chat Conversations Yet</h4>
            <p class="text-muted">Customer messages about orders will appear here.</p>
        </div>
    }
</div>
