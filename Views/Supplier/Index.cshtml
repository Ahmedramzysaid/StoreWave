@model StoreWave.ViewModels.SupplierDashboardViewModel

@{
    ViewData["Title"] = "Supplier Dashboard";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold text-primary">
                <i class="bi bi-shop me-2"></i>Supplier Dashboard
            </h1>
            <p class="text-muted mb-0">Manage your products and track performance</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add New Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-box-seam display-4"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h2 class="mb-0">@Model.TotalProducts</h2>
                            <p class="mb-0 opacity-75">Total Products</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-check-circle display-4"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h2 class="mb-0">@Model.ActiveProducts</h2>
                            <p class="mb-0 opacity-75">Active Products</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-exclamation-triangle display-4"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h2 class="mb-0">@Model.OutOfStockProducts</h2>
                            <p class="mb-0">Out of Stock</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-shrink-0">
                            <i class="bi bi-currency-dollar display-4"></i>
                        </div>
                        <div class="flex-grow-1 ms-3">
                            <h2 class="mb-0">$@Model.TotalSales.ToString("N2")</h2>
                            <p class="mb-0 opacity-75">Total Sales</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Recent Products -->
    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-lightning me-2"></i>Quick Actions</h5>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Products" class="btn btn-outline-primary">
                            <i class="bi bi-box-seam me-2"></i>View All Products
                        </a>
                        <a asp-action="Create" class="btn btn-outline-success">
                            <i class="bi bi-plus-lg me-2"></i>Add New Product
                        </a>
                        <a asp-action="Orders" class="btn btn-outline-info">
                            <i class="bi bi-bag me-2"></i>View Orders
                        </a>
                        <a asp-controller="Account" asp-action="Profile" class="btn btn-outline-success">
                            <i class="bi bi-person-circle me-2"></i>My Profile
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Recent Products</h5>
                    <a asp-action="Products" class="btn btn-sm btn-outline-primary">View All</a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentProducts.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Product</th>
                                        <th>Price</th>
                                        <th>Stock</th>
                                        <th>Status</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var product in Model.RecentProducts)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/50x50?text=P" : product.ImageUrl)" 
                                                         class="rounded me-2" width="40" height="40" style="object-fit: cover;" />
                                                    <span class="fw-medium">@product.Name</span>
                                                </div>
                                            </td>
                                            <td>$@product.CurrentPrice.ToString("N2")</td>
                                            <td>
                                                <span class="badge @(product.StockQuantity == 0 ? "bg-danger" : product.StockQuantity <= 10 ? "bg-warning" : "bg-success")">
                                                    @product.StockQuantity
                                                </span>
                                            </td>
                                            <td>
                                                @if (product.IsActive)
                                                {
                                                    <span class="badge bg-success">Active</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Inactive</span>
                                                }
                                            </td>
                                            <td>
                                                <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-box-seam display-4 text-muted"></i>
                            <p class="text-muted mt-2">No products yet. Start by adding your first product!</p>
                            <a asp-action="Create" class="btn btn-primary">
                                <i class="bi bi-plus-lg me-1"></i>Add Product
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
