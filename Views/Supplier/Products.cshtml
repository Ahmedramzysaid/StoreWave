@model IEnumerable<StoreWave.DTOs.ProductDto>

@{
    ViewData["Title"] = "My Products";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="display-6 fw-bold">
                <i class="bi bi-box-seam me-2"></i>My Products
            </h1>
            <p class="text-muted mb-0">Manage your product listings</p>
        </div>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>Add New Product
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Product</th>
                            <th>Category</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var product in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/50x50?text=P" : product.ImageUrl)" 
                                             class="rounded me-3" width="50" height="50" style="object-fit: cover;" />
                                        <div>
                                            <span class="fw-medium">@product.Name</span>
                                            @if (product.IsFeatured)
                                            {
                                                <span class="badge bg-warning text-dark ms-1">Featured</span>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>@product.CategoryName</td>
                                <td>
                                    @if (product.IsOnSale)
                                    {
                                        <span class="text-decoration-line-through text-muted">$@product.Price.ToString("N2")</span>
                                        <br />
                                        <span class="text-danger fw-bold">$@product.DiscountPrice?.ToString("N2")</span>
                                    }
                                    else
                                    {
                                        <span>$@product.Price.ToString("N2")</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(product.StockQuantity == 0 ? "bg-danger" : product.StockQuantity <= 10 ? "bg-warning text-dark" : "bg-success")">
                                        @product.StockQuantity units
                                    </span>
                                </td>
                                <td>
                                    @if (product.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-outline-primary me-1" title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline" 
                                          onsubmit="return confirm('Are you sure you want to delete this product?');">
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-box-seam display-1 text-muted"></i>
                <h4 class="mt-3">No Products Yet</h4>
                <p class="text-muted">Start by adding your first product to the store.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-lg me-1"></i>Add Your First Product
                </a>
            </div>
        </div>
    }

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
        </a>
    </div>
</div>
